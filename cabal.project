-- OmniHaskell monorepo: one project file, many packages. The repo is the
-- unit of consistency; packages are the unit of reuse.
packages:
  packages/omni-core
  packages/omni-app

-- Guard against registry skew: never build against a partial Hackage index.
index-state: 2026-10-01T00:00:00Z

-- Estate parity: warnings are errors under CI. Scoped to WORKSPACE
-- packages only — `package *` would also apply to dependencies built from
-- source, killing the build on their warnings (e.g. hashable under -Wunused-
-- imports on 9.10). Local builds can relax via
-- cabal configure --ghc-options="-Wno-error".
package omni-core
  ghc-options: -Werror

package omni-app
  ghc-options: -Werror
